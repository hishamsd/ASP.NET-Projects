@model Plan
@{
    ViewData["Title"] = "Create Plan";
}

<h1>Create Plan</h1>

<div class="container">
    <div asp-validation-summary="All" class="text-danger"></div>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="form-group">
            <label class="control-label">Name</label>
            <input asp-for="Name" class="form-control" />
        </div>
        <div class="form-group">
            <label class="control-label">Price</label>
            <input asp-for="Price" class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="CategoryId">فئة النادي</label>
            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-control">
                <option value="">غير مصنفة (لا تظهر في التطبيق)</option>
            </select>
        </div>
        <div class="form-group">
            <label asp-for="DurationMonths">المدة بالأشهر</label>
            <input asp-for="DurationMonths" type="number" min="1" max="120" class="form-control" />
        </div>
        <div class="form-group">
            <label for="image">صورة الخطة (اختيارية)</label>
            <input type="file" id="image" name="image" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
            <span class="text-danger">@Html.ValidationMessage("image")</span>
        </div>
        <div class="form-group">
            <label class="control-label">Description</label>
            <input asp-for="Description" class="form-control" />
        </div>
        <div class="form-group">
            <input type="submit" value="Create" class="btn btn-primary" />
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </form>

</div>

