@model IEnumerable<Plan>

@{
    ViewData["Title"] = "Plan Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome Plan</h1>
</div>

<div class="container">
    <div class="row text-end">
        <div class="col-md-12">
            <a asp-action="Create" class="btn btn-primary">Create New Plan</a>
        </div>
    </div>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>
                    ID
                </th>
                <th>
                    Name
                </th>
                <th>
                    Price
                </th>
                <th>
                    Description
                </th>
                <th>
                    Actions
                </th>
            </tr>
        </thead>

        <tbody>
            @foreach (var name in Model)
            {
                <tr>
                    <td>
                        @name.Id
                    </td>
                    <td>
                        @name.Name
                    </td>
                    <td>
                        @name.Price
                    </td>
                    <td>
                        @name.Description
                    </td>
                   
                   <td>
    <a asp-action="Edit" asp-route-id="@name.Id" class="btn btn-warning">Edit</a>

    <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@name.Id">
        Delete
    </button>

    <div class="modal fade" id="deleteModal-@name.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Confirmation</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete <strong>@name.Name</strong>?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form asp-action="Delete" asp-route-id="@name.Id" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-danger">Confirm Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</td>
                </tr>
            }
        </tbody>
    </table>
</div>
