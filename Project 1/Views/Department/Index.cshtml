@using Project_1.Dtos.HRDtos
@model IEnumerable<DepartmentDto>

@{
    ViewData["Title"] = "الأقسام";
    int count = 1;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>الأقسام</h2>

        <a asp-action="Create" class="btn btn-primary">
            إضافة قسم
        </a>
    </div>

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">
            @error
        </div>
    }

    <table class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>#</th>
                <th>ID</th>
                <th>اسم القسم</th>
                <th>الإجراءات</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var name in Model)
            {
                <tr>
                    <td>@count</td>
                    <td>@name.Id</td>
                    <td>@name.Name</td>

                    <td>
                        <a asp-controller="Department"
                           asp-action="Edit"
                           asp-route-id="@name.Id"
                           class="btn btn-warning">
                            تعديل
                        </a>

                        <button type="button"
                                class="btn btn-danger"
                                data-toggle="modal"
                                data-target="#deleteModal-@name.Id">
                            حذف
                        </button>
                    </td>
                </tr>

                count++;
            }
        </tbody>

    </table>

</div>

@foreach (var name in Model)
{
    <div class="modal fade"
         id="deleteModal-@name.Id"
         tabindex="-1"
         role="dialog"
         aria-labelledby="deleteTitle-@name.Id"
         aria-hidden="true">

        <div class="modal-dialog" role="document">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="deleteTitle-@name.Id">
                        تأكيد الحذف
                    </h5>

                    <button type="button"
                            class="close"
                            data-dismiss="modal"
                            aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="modal-body">
                    هل أنت متأكد من حذف القسم
                    <strong>@name.Name</strong>؟
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-dismiss="modal">
                        إلغاء
                    </button>

                    <form asp-controller="Department"
                          asp-action="DeleteConfirmed"
                          asp-route-id="@name.Id"
                          method="post"
                          class="d-inline">

                        <button type="submit" class="btn btn-danger">
                            تأكيد الحذف
                        </button>

                    </form>
                </div>

            </div>
        </div>

    </div>
}