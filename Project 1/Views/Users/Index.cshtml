﻿@using Project_1.Dtos.UsersDtos
@model IEnumerable<UserDto>

@{
    ViewData["Title"] = "User Page";
    int count = 1;
}

<div class="text-center">
    <h1 class="display-4">Welcome User</h1>
</div>


<div class="container">
    <a asp-action="Create" class="btn btn-primary mb-3">Create New User</a>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>
                    #
                </th>
                <th>
                    ID
                </th>
                <th>
                    Name
                </th>
                <th>
                    image
                </th>

                <th>View Roles</th>

               
                <th>Actions</th>

            </tr>
        </thead>

        <tbody>

            @foreach (var name in Model)
            {

                <tr>
                    <td>
                        @count
                        @{
                            count++;
                        }
                    </td>

                    <td>
                        @name.Id
                    </td>
                    <td>
                        @name.Name
                    </td>

                    <td>
                        @if (!string.IsNullOrEmpty(name.ImageURL))
                        {
                            <img src="@name.ImageURL"
                                 width="60"
                                 height="60"
                                 style="object-fit:cover;border-radius:50%;" />
                        }
                        else
                        {
                            <span>No Image</span>
                        }

                    </td>
                    <td>
                        <a asp-controller="Users"
                           asp-action="ManageRoles"
                           asp-route-Id="@name.Id"
                           class="btn btn-info">
                            View Roles
                        </a>

                        <a asp-controller="Users"
                           asp-action="ManageFiles"
                           asp-route-UserId="@name.Id"
                           class="btn btn-primary">
                            Files
                        </a>
                    </td>

                    <td>
                        <a asp-action="Edit" asp-route-uid="@name.UID" class="btn btn-warning">Edit</a>
                        <form asp-action="DeleteConfirmed" asp-route-id="@name.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </form>

                    </td>

                </tr>
            }


        </tbody>

    </table>


</div>