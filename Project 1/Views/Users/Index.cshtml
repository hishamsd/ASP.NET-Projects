@using Project_1.Application.Dtos.UsersDtos
@model IEnumerable<UserDto>

@{
    ViewData["Title"] = "User Page";
    int count = 1;
}

<div class="text-center">
    <h1 class="display-4">Welcome User</h1>
</div>

<div class="container">

    <a asp-action="Create" class="btn btn-primary mb-3">
        Create New User
    </a>

    <div class="table-responsive">

        <table class="table table-striped" dir="ltr">

            <thead>
                <tr>
                    <th>#</th>
                    <th>ID</th>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Roles / Files</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var name in Model)
                {
                    <tr>
                        <td>
                            @count
                            @{
                                count++;
                            }
                        </td>

                        <td>@name.Id</td>

                        <td>
                            @if (!string.IsNullOrEmpty(name.ImageURL))
                            {
                                <img src="@name.ImageURL"
                                     alt="@name.Name"
                                     width="60"
                                     height="60"
                                     style="object-fit:cover;border-radius:50%;" />
                            }
                            else
                            {
                                <span>No Image</span>
                            }
                        </td>

                        <td>@name.Name</td>

                        <td>@name.Email</td>

                        <td>@name.Phone</td>

                        <td>
                            <a asp-controller="Users"
                               asp-action="ManageRoles"
                               asp-route-id="@name.Id"
                               class="btn btn-info">
                                View Roles
                            </a>

                            <a asp-controller="Users"
                               asp-action="ManageFiles"
                               asp-route-UserId="@name.Id"
                               class="btn btn-primary">
                                Files
                            </a>
                        </td>

                        <td>
                           <a asp-controller="Users"
                              asp-action="Edit"
                              asp-route-id="@name.Id"
                              class="btn btn-warning">
                              Edit
                          </a>

                            <form asp-controller="Users"
                                  asp-action="DeleteConfirmed"
                                  asp-route-id="@name.Id"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('هل أنت متأكد من حذف هذا المستخدم؟');">

                                <button type="submit" class="btn btn-danger">
                                    Delete
                                </button>

                            </form>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>