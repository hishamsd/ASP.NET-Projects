@model Role

@{
    ViewData["Title"] = "Assign Permissions";

    var allPermissions = ViewBag.AllPermissions as List<Permission>;
    var assignedPermissions = ViewBag.AssignedPermissions as List<int>;
}

<div class="container mt-4">

    <h2>Assign Permissions</h2>

    <div class="card mt-3">

        <div class="card-header">
            Role:
            <strong>@Model.Name</strong>
        </div>

        <div class="card-body">

            <form asp-action="AssignPermissions" method="post">

                <!-- Role Id -->
                <input type="hidden"
                       name="roleId"
                       value="@Model.Id" />


                @foreach (var permission in allPermissions)
                {
                    <div class="form-check mb-2">

                        <input class="form-check-input"
                               type="checkbox"
                               name="permissionIds"
                               value="@permission.Id"
                               id="permission_@permission.Id"
                               checked="@(assignedPermissions.Contains(permission.Id))" />

                        <label class="form-check-label"
                               for="permission_@permission.Id">

                            @permission.Name

                        </label>

                    </div>
                }


                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-primary">
                        Save Permissions
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Back
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>