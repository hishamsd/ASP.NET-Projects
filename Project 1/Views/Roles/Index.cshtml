@model IEnumerable<Role>

@{
    ViewData["Title"] = "Roles";
    int counter = 1;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between mb-3">

        <h2>Role List</h2>

        <!-- Open Create Modal -->
        <button class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#createModal">
            Create Role
        </button>

    </div>
          <!-- ========================= -->
    <!-- Roles Table -->
    <!-- ========================= -->

    <table class="table table-bordered table-hover">

        <thead class="table-primary">

            <tr>
                <th>#</th>
                <th>ID</th>
                <th>Name</th>
                <th>Permissions</th>
                <th>Actions</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var Role in Model)
            {
                <tr>
                    <td>@counter</td>

                    @{
                        counter++;
                    }



                    <td>@Role.Id</td>

                    <td>@Role.Name</td>

                    <td>
                            <a asp-controller="Roles"
                           asp-action="AssignPermissions"
                           asp-route-roleId="@Role.Id"
                               class="btn btn-info">
                            View Permissions
                        </a>
                        </td>

                    <td>
                        <!-- Open Edit Modal -->
                        <button class="btn btn-warning"
                                data-bs-toggle="modal"
                                data-bs-target="#editModal-@Role.Id">
                            Edit Role
                        </button>


                        <!-- Open Edit Modal -->
                        <button class="btn btn-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteModal-@Role.Id">
                            Delete Role
                        </button>
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>



    <!-- ================================================= -->
    <!-- CREATE MODAL -->
    <!-- ================================================= -->

    <div class="modal fade"
         id="createModal"
         tabindex="-1">

        <div class="modal-dialog">

            <div class="modal-content">

                <form asp-action="Create" method="post">

                    <div class="modal-header">

                        <h5 class="modal-title">
                            Create Role
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>

                    </div>


                    <div class="modal-body">

                        <div class="mb-3">

                            <label class="form-label">
                                Role Name
                            </label>

                            <input name="Name"
                                   class="form-control"
                                   placeholder="Enter role name" />

                        </div>

                    </div>


                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn btn-primary">
                            Create
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>



                        
<!-- ================================================= -->
<!-- EDIT + DELETE MODALS -->
<!-- ================================================= -->
@foreach (var Role in Model)
{
    <!-- ========================= -->
    <!-- EDIT MODAL -->
    <!-- ========================= -->

    <div class="modal fade"
    id="editModal-@Role.Id"
    tabindex="-1">

        <div class="modal-dialog">

            <div class="modal-content">

                <form asp-action="Edit" method="post">

                    <!-- Important -->
                    <input type="hidden"
                    name="Id"
                    value="@Role.Id" />


                    <div class="modal-header">

                        <h5 class="modal-title">
                            Edit Role
                        </h5>

                        <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                        </button>

                    </div>


                    <div class="modal-body">

                        <div class="mb-3">

                            <label class="form-label">
                                Role Name
                            </label>

                            <input type="text"
                            name="Name"
                            value="@Role.Name"
                            class="form-control" />

                        </div>

                    </div>


                    <div class="modal-footer">

                        <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                        class="btn btn-warning">
                            Save Changes
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>




    <!-- ========================= -->
    <!-- DELETE MODAL -->
    <!-- ========================= -->

    <div class="modal fade"
         id="deleteModal-@Role.Id"
         tabindex="-1">

        <div class="modal-dialog">

            <div class="modal-content">

                <form asp-action="DeleteConfirmed" method="post">

                    <input type="hidden"
                           name="id"
                           value="@Role.Id" />


                    <div class="modal-header">

                        <h5 class="modal-title">
                            Delete Role
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>

                    </div>


                    <div class="modal-body">

                        <p>
                            Are you sure you want to delete
                            <strong>@Role.Name</strong>?
                        </p>

                    </div>


                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn btn-danger">
                            Delete
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>




}
