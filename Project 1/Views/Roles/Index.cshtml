@model IEnumerable<Project_1.Models.Role>

@{
    ViewData["Title"] = "Roles";
    int counter = 1;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between mb-3">
        <h2>Role List</h2>

        <button type="button"
                class="btn btn-primary"
                data-toggle="modal"
                data-target="#createModal">
            Create Role
        </button>
    </div>

    <div asp-validation-summary="All"
         class="text-danger"></div>

    <!-- Roles Table -->
    <table class="table table-bordered table-hover">
        <thead class="table-primary">
            <tr>
                <th>#</th>
                <th>ID</th>
                <th>Name</th>
                <th>Permissions</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var Role in Model)
            {
                <tr>
                    <td>@counter</td>

                    @{
                        counter++;
                    }

                    <td>@Role.Id</td>
                    <td>@Role.Name</td>

                    <td>
                        <a asp-controller="Roles"
                           asp-action="AssignPermissions"
                           asp-route-roleId="@Role.Id"
                           class="btn btn-info">
                            View Permissions
                        </a>
                    </td>

                    <td>
                        <button type="button"
                                class="btn btn-warning"
                                data-toggle="modal"
                                data-target="#editModal-@Role.Id">
                            Edit Role
                        </button>

                        <button type="button"
                                class="btn btn-danger"
                                data-toggle="modal"
                                data-target="#deleteModal-@Role.Id">
                            Delete Role
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Create Modal -->
<div class="modal fade"
     id="createModal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="createModalTitle"
     aria-hidden="true">

    <div class="modal-dialog" role="document">
        <div class="modal-content">

            <form asp-controller="Roles"
                  asp-action="Create"
                  method="post">

                <div class="modal-header">
                    <h5 class="modal-title" id="createModalTitle">
                        Create Role
                    </h5>

                    <button type="button"
                            class="close"
                            data-dismiss="modal"
                            aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="modal-body">
                    <div class="form-group">
                        <label for="createRoleName">
                            Role Name
                        </label>

                        <input type="text"
                               id="createRoleName"
                               name="Name"
                               class="form-control"
                               placeholder="Enter role name"
                               required />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" class="btn btn-primary">
                        Create
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit + Delete Modals -->
@foreach (var Role in Model)
{
    <!-- Edit Modal -->
    <div class="modal fade"
         id="editModal-@Role.Id"
         tabindex="-1"
         role="dialog"
         aria-labelledby="editModalTitle-@Role.Id"
         aria-hidden="true">

        <div class="modal-dialog" role="document">
            <div class="modal-content">

                <form asp-controller="Roles"
                      asp-action="Edit"
                      method="post">

                    <input type="hidden"
                           name="Id"
                           value="@Role.Id" />

                    <div class="modal-header">
                        <h5 class="modal-title"
                            id="editModalTitle-@Role.Id">
                            Edit Role
                        </h5>

                        <button type="button"
                                class="close"
                                data-dismiss="modal"
                                aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>

                    <div class="modal-body">
                        <div class="form-group">
                            <label for="editRoleName-@Role.Id">
                                Role Name
                            </label>

                            <input type="text"
                                   id="editRoleName-@Role.Id"
                                   name="Name"
                                   value="@Role.Name"
                                   class="form-control"
                                   required />
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                data-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit" class="btn btn-warning">
                            Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade"
         id="deleteModal-@Role.Id"
         tabindex="-1"
         role="dialog"
         aria-labelledby="deleteModalTitle-@Role.Id"
         aria-hidden="true">

        <div class="modal-dialog" role="document">
            <div class="modal-content">

                <form asp-controller="Roles"
                      asp-action="DeleteConfirmed"
                      method="post">

                    <input type="hidden"
                           name="id"
                           value="@Role.Id" />

                    <div class="modal-header">
                        <h5 class="modal-title"
                            id="deleteModalTitle-@Role.Id">
                            تأكيد الحذف
                        </h5>

                        <button type="button"
                                class="close"
                                data-dismiss="modal"
                                aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>

                    <div class="modal-body">
                        <p>
                            هل أنت متأكد من حذف الرول
                            <strong>@Role.Name</strong>؟
                        </p>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                data-dismiss="modal">
                            إلغاء
                        </button>

                        <button type="submit" class="btn btn-danger">
                            تأكيد الحذف
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}