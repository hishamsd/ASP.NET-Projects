@using Project_1.Application.Dtos.GymDtos
@model IEnumerable<MemberDto>

@{
    ViewData["Title"] = "Member Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome Member</h1>
</div>

<div class="container">

    <div class="row text-end">
        <div class="col-md-12">
            <a asp-action="Create" class="btn btn-primary">
                Create New Member
            </a>
        </div>
    </div>

    <table class="table table-striped">

        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>PhoneNumber</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var name in Model)
            {
                <tr>
                    <td>@name.Id</td>
                    <td>@name.Name</td>
                    <td>@name.PhoneNumber</td>

                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@name.Id"
                           class="btn btn-warning">
                            Edit
                        </a>

                        <button type="button"
                                class="btn btn-danger"
                                data-toggle="modal"
                                data-target="#deleteModal-@name.Id">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>

    </table>

</div>

@foreach (var name in Model)
{
    <div class="modal fade"
         id="deleteModal-@name.Id"
         tabindex="-1"
         role="dialog"
         aria-labelledby="deleteTitle-@name.Id"
         aria-hidden="true">

        <div class="modal-dialog" role="document">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="deleteTitle-@name.Id">
                        Delete Confirmation
                    </h5>

                    <button type="button"
                            class="close"
                            data-dismiss="modal"
                            aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="modal-body">
                    Are you sure you want to delete
                    <strong>@name.Name</strong>?
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-dismiss="modal">
                        Cancel
                    </button>

                    <form asp-controller="Member"
                          asp-action="Delete"
                          asp-route-id="@name.Id"
                          method="post"
                          class="d-inline">

                        <button type="submit" class="btn btn-danger">
                            Confirm Delete
                        </button>

                    </form>
                </div>

            </div>
        </div>

    </div>
}