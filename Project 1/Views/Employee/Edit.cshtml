@using Project_1.Application.Dtos.HRDtos
@model UpdateEmployeeDto

@{
    ViewData["Title"] = "تعديل موظف";
}

<h1>تعديل موظف</h1>

<form asp-controller="Employee"
      asp-action="Edit"
      method="post"
      enctype="multipart/form-data">

    <div asp-validation-summary="All"
         class="text-danger"></div>

    <input asp-for="Id" type="hidden" />
    <input asp-for="UID" type="hidden" />

    <div class="mb-3">
        <label asp-for="Name">الاسم</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email">البريد الإلكتروني</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Phone">رقم الجوال</label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="JobId">الوظيفة</label>
        <select asp-for="JobId"
                asp-items="ViewBag.Jobs"
                class="form-control">
        </select>
        <span asp-validation-for="JobId"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DepartmentId">القسم</label>
        <select asp-for="DepartmentId"
                asp-items="ViewBag.Departments"
                class="form-control">
        </select>
        <span asp-validation-for="DepartmentId"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Image">صورة جديدة</label>
        <input asp-for="Image"
               type="file"
               class="form-control"
               accept=".jpg,.jpeg,.png,.webp" />
        <span asp-validation-for="Image"
              class="text-danger"></span>

        <small class="text-muted">
            اترك الصورة فارغة للاحتفاظ بالصورة الحالية.
        </small>
    </div>

    <button type="submit" class="btn btn-primary">
        حفظ التعديلات
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        رجوع
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}